# Copy to backend/.env and fill in as needed. Never commit real keys.

# --- Generative AI (optional). Leave keys empty to run in retrieval-only mode. ---
# LLM_PROVIDER: auto | openai | gemini | none
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Models: auto | transformer | baseline ---
EMOTION_MODEL=auto
STRESS_MODEL=auto
LIME_NUM_SAMPLES=300
